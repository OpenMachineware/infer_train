kernel void test_iq1_s_dequant(
    device const block_iq1_s * block [[buffer(0)]],
    device float * output [[buffer(1)]],
    uint tid [[thread_position_in_threadgroup]]
) {
    // Dequantize first 32-element sub-block (il=0)
    if (tid < 32) {
        const int il = 0;
        const int ib32 = tid / 16;  // 0 or 1 for first 32 elements
        const int i = tid % 16;     // 0-15 within sub-block

        const float d = block->d;
        device const uint8_t * qs = block->qs + 2 * il;
        device const uint16_t * qh = block->qh;
        const float dl = d * (2 * ((qh[ib32] >> 12) & 7) + 1);
        const float ml = dl * (qh[ib32] & 0x8000 ? -1 - IQ1S_DELTA : -1 + IQ1S_DELTA);
        const uint16_t h = qh[ib32] >> (6 * il);

        // Determine which grid to use
        constant uint8_t * grid;
        uint idx;
        if (i < 8) {
            grid = (constant uint8_t *)(iq1s_grid_gpu + (qs[0] | ((h << 8) & 0x700)));
            idx = i;
        } else {
            grid = (constant uint8_t *)(iq1s_grid_gpu + (qs[1] | ((h << 5) & 0x700)));
            idx = i - 8;
        }

        // Extract nibbles and dequantize
        float val;
        if (i < 8) {
            val = dl * (grid[idx] & 0xf) + ml;  // Low nibble
        } else {
            val = dl * (grid[idx] >> 4) + ml;   // High nibble
        }

        output[tid] = val;
    }
}

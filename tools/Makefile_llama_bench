# Makefile for llama.cpp flash attention benchmark wrapper

LLAMA_ROOT = ../llama.cpp-0.6.0
LLAMA_BUILD = $(LLAMA_ROOT)/build
LLAMA_INCLUDE = $(LLAMA_ROOT)
LLAMA_LIB = $(LLAMA_BUILD)/bin

# Compiler settings
CXX = clang++
CXXFLAGS = -std=c++17 -fPIC -O3 -I$(LLAMA_INCLUDE) -I$(LLAMA_INCLUDE)/ggml/include

# Linker settings
LDFLAGS = -dynamiclib \
	-L$(LLAMA_LIB) \
	-lggml-metal -lggml-cpu -lggml-base -lggml \
	-framework Metal -framework Foundation

# Target
TARGET = libllama_fa_bench.dylib

all: $(TARGET)

$(TARGET): llama_flash_attn_bench.cpp
	$(CXX) $(CXXFLAGS) -o $@ $< $(LDFLAGS)

clean:
	rm -f $(TARGET)

test: $(TARGET)
	@echo "Testing library load..."
	otool -L $(TARGET)

.PHONY: all clean test

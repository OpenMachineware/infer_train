// Self-written Matrix-Vector Multiplication Template
// Supports all common quantization formats
// Based on verified Q4_K architecture: 100.39% of llama.cpp

#include <metal_stdlib>
using namespace metal;

#define QK_K 256
#define QK 32

// Block sizes for standard quantization
#define QK1_0 32
#define QK2_0 64
#define QK5_0 32
#define QK5_1 32
#define QK4_NL 32
#define QK_MXFP4 32

// Loop unrolling macro
#define FOR_UNROLL(x) _Pragma("clang loop unroll(full)") for (x)

// ============================================================================
// Block structures
// ============================================================================

// K-quant formats
typedef struct {
    half  d;
    half  dmin;
    uint8_t scales[12];
    uint8_t qs[128];
} block_q4_K;

typedef struct {
    half  d;
    half  dmin;
    uint8_t scales[12];
    uint8_t qh[32];  // QK_K/8 = 256/8 = 32 (NOT 64!)
    uint8_t qs[128]; // QK_K/2 = 256/2 = 128
} block_q5_K;

typedef struct {
    uint8_t scales[16];  // QK_K/16 = 256/16 = 16
    uint8_t qs[64];      // QK_K/4 = 256/4 = 64
    half  d;
    half  dmin;
} block_q2_K;

typedef struct {
    uint8_t hmask[32];
    uint8_t qs[64];
    uint8_t scales[12];
    half  d;
} block_q3_K;

typedef struct {
    uint8_t ql[128];
    uint8_t qh[64];
    int8_t scales[16];
    half  d;
} block_q6_K;

// Standard quantization formats
typedef struct {
    half d;
    uint8_t qs[16];
} block_q4_0;

typedef struct {
    half d;
    half m;
    uint8_t qs[16];
} block_q4_1;

typedef struct {
    half d;
    uint8_t qs[32];
} block_q8_0;

typedef struct {
    half d;
    uint8_t qs[4];
} block_q1_0;

typedef struct {
    half d;
    uint8_t qs[16];
} block_q2_0;

typedef struct {
    half d;
    uint8_t qh[4];
    uint8_t qs[16];
} block_q5_0;

typedef struct {
    half d;
    half m;
    uint8_t qh[4];
    uint8_t qs[16];
} block_q5_1;

// IQ formats
typedef struct {
    half  d;
    uint8_t  qs[32];
    uint16_t qh[8];
} block_iq1_s;

typedef struct {
    uint8_t  qs[32];
    uint8_t  qh[16];
    uint16_t scales[4];
} block_iq1_m;

typedef struct {
    half d;
    uint16_t qs[32];
} block_iq2_xxs;

typedef struct {
    half d;
    uint16_t qs[32];
    uint8_t scales[8];
} block_iq2_xs;

typedef struct {
    half d;
    uint8_t qs[32];
    uint8_t qh[8];
    uint8_t signs[32];
    uint8_t scales[8];
} block_iq2_s;

typedef struct {
    half d;
    uint8_t qs[32];
    uint16_t qh[16];
} block_iq3_xxs;

typedef struct {
    half d;
    uint8_t qs[32];
    uint8_t qh[8];
    uint8_t signs[16];
    uint8_t scales[4];
} block_iq3_s;

typedef struct {
    half d;
    uint8_t qs[16];  // QK4_NL/2 = 32/2 = 16
} block_iq4_nl;

typedef struct {
    half d;
    uint8_t qs[32];
    uint16_t scales_h;
    uint8_t scales_l[8];
} block_iq4_xs;

// TQ format
typedef struct {
    half d;
    uint8_t qs[64];
} block_tq2_0;

// MXFP4 format
typedef struct {
    uint8_t e;
    uint8_t qs[16];
} block_mxfp4;

// ============================================================================
// Kernel arguments
// ============================================================================

typedef struct {
    int32_t ne00; int32_t ne01; int32_t ne02;
    uint64_t nb00; uint64_t nb01; uint64_t nb02; uint64_t nb03;
    int32_t ne10; int32_t ne11; int32_t ne12;
    uint64_t nb10; uint64_t nb11; uint64_t nb12; uint64_t nb13;
    int32_t ne0; int32_t ne1;
    int32_t nr0;
    int16_t r2;
    int16_t r3;
} ggml_metal_kargs_mul_mv;

// ============================================================================
// Function constants
// ============================================================================

constant short FC_nsg  [[function_constant(600)]];
constant short FC_ne12 [[function_constant(602)]];
constant short FC_r2   [[function_constant(603)]];
constant short FC_r3   [[function_constant(604)]];

